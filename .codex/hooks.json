{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/trailwire hook codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "/opt/homebrew/Caskroom/ollie-hooks/1.1.2/ollie-hooks hook codex",
            "statusMessage": "Running ollie-hooks",
            "timeout": 86400,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "/Users/joeystout/bin/plannotator-review-gate hook codex",
            "statusMessage": "Waiting for Plannotator review",
            "timeout": 345600,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/trailwire hook codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "/opt/homebrew/Caskroom/ollie-hooks/1.1.2/ollie-hooks hook codex",
            "statusMessage": "Running ollie-hooks",
            "timeout": 86400,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/trailwire hook codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/trailwire hook codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/joeystout/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/Users/joeystout/.codex/rex-subagent-start.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/joeystout/.codex/rex-subagent-stop.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/trailwire hook codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/joeystout/.local/bin/plannotator",
            "timeout": 345600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/opt/homebrew/bin/trailwire hook codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/opt/homebrew/Caskroom/ollie-hooks/1.1.2/ollie-hooks hook codex",
            "statusMessage": "Running ollie-hooks",
            "timeout": 86400,
            "type": "command"
          }
        ]
      }
    ]
  }
}
