# One file for every host. The YubiKey is detected by its PIV agent socket: with
# it, the card's precheck and identity; without it, the shared agent key that
# the yadm bootstrap materialises from the vault (home repo ADR 0005).
Include ~/.orbstack/ssh/config

Match exec "test -S ~/.ssh/agent.sock && /Users/joeystout/projects/src/github.com/TheOutdoorProgrammer/home/scripts/piv-ssh-precheck.sh"

Match exec "test -S ~/.ssh/agent.sock"
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_rsa_yubikey.pub

Match exec "test ! -S ~/.ssh/agent.sock"
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_agent
