{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ollie",
  "experimental": {
    "mcp_lazy": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16384,
    "tail_turns": 3,
    "preserve_recent_tokens": 4000
  },
  "lsp": {
    "marksman": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md"
      ]
    }
  },
  "agent": {
    "ollie": {
      "model": "anthropic/claude-opus-4-6",
      "color": "#50FA7B",
      "tools": {
        "notion_*": false,
        "google-calendar_*": false
      }
    },
    "build": {
      "mode": "subagent",
      "hidden": true
    },
    "plan": {
      "mode": "subagent",
      "hidden": true
    },
    "reviewer": {
      "mode": "subagent",
      "hidden": true,
      "tools": {
        "notion_*": false,
        "google-calendar_*": false,
        "granola_*": false
      }
    },
    "worker": {
      "description": "General-purpose subagent for parallel data gathering and multi-step subtasks",
      "mode": "subagent",
      "hidden": true,
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "permission": {
    "task": "allow",
    "question": "allow"
  },
  "tools": {
    "obsidian_obsidian_put_*": false,
    "obsidian_obsidian_post_*": false,
    "obsidian_obsidian_patch_*": false,
    "obsidian_obsidian_delete_*": false,
    "obsidian_obsidian_execute_command": false
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "all-agents"
      }
    ],
    "opencode-pty"
  ],
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "bun",
        "/Users/joeystout/projects/src/github.com/fazer-ai/mcp-obsidian/dist/index.js"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.notion.com/mcp"
      ],
      "enabled": true
    },
    "google-calendar": {
      "type": "local",
      "command": [
        "npx",
        "@cocal/google-calendar-mcp"
      ],
      "enabled": true,
      "environment": {
        "GOOGLE_OAUTH_CREDENTIALS": "/Users/joeystout/Documents/google-mcp-creds.json"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "granola": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.granola.ai/mcp"
      ],
      "enabled": true
    },
    "davinci-resolve": {
      "type": "local",
      "command": [
        "/Users/joeystout/projects/src/github.com/samuelgursky/davinci-resolve-mcp/venv/bin/python",
        "/Users/joeystout/projects/src/github.com/samuelgursky/davinci-resolve-mcp/src/server.py"
      ],
      "enabled": true
    },
    "home-assistant": {
      "type": "local",
      "command": [
        "/Users/joeystout/.local/bin/uvx",
        "--python",
        "3.13",
        "--refresh",
        "ha-mcp@latest"
      ],
      "enabled": true,
      "environment": {
        "HOMEASSISTANT_URL": "https://home.stout.zone",
        "HOMEASSISTANT_TOKEN": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiIwOTBmYjRhNDgzNTM0MDI4YTE0ZDUzNDA0Njg3OWIxMSIsImlhdCI6MTc3NzU2NzY2NSwiZXhwIjoyMDkyOTI3NjY1fQ.ymD8R0tLlU1qY9SENUqVSQRnQnf87LG94dkSeLa3i3k"
      }
    }
  },
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.stout.zone/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.stout.zone/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.stout.zone/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    }
  }
}
