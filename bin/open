#!/usr/bin/env bash
# PATH shim for `open`. Routes a lone http(s):// URL by destination:
#   - localhost / 127.0.0.1 (inside muxy) -> background browser TAB in muxy
#   - any other http(s) URL               -> Google Chrome
#   - everything else (files, apps, flags, multiple args) -> real /usr/bin/open

# Open as a muxy browser tab WITHOUT ripping the user there. `browser open` has
# no background flag and takes focus within the project, so the previously
# selected tab is restored immediately and the waiting page is badged (bell +
# amber) to stay noticeable. --project pins the tab to the CALLER's project;
# untargeted it lands wherever the user happens to be looking.
#
# The badge does not self-clear on open: muxy's browser ignores window.close()
# and offers no unread flag, so the icon stays until the tab is closed.
open_in_muxy() {
  command -v muxy >/dev/null 2>&1 || return 1
  local -a target=()
  [ -n "${MUXY_PROJECT_ID:-}" ] && target=(--project "$MUXY_PROJECT_ID")
  local prev tab
  prev=$(muxy list-tabs "${target[@]}" 2>/dev/null | awk -F'\t' '$5=="true"{print $2; exit}')
  tab=$(muxy browser open "$1" "${target[@]}" 2>/dev/null)
  [ -n "$tab" ] || return 1
  # Hand the tab id to the caller so it can close the page when it's done with
  # it; muxy's browser ignores window.close(), so pages can't close themselves.
  [ -n "${JOEY_OPEN_TAB_FILE:-}" ] && printf '%s\n' "$tab" > "$JOEY_OPEN_TAB_FILE"
  [ -n "$prev" ] && [ "$prev" != "$tab" ] && muxy switch-tab "$prev" "${target[@]}" >/dev/null 2>&1
  muxy tab set-icon "$tab" "bell.badge.fill" >/dev/null 2>&1
  muxy tab set-color "$tab" amber >/dev/null 2>&1
  exit 0
}

# Regex in a var, not inline: bash mangles \[ inside a literal [[ =~ ]] pattern.
localhost_re='^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])(:[0-9]+)?([/?#]|$)'

if [ "$#" -eq 1 ]; then
  case "$1" in
    http://* | https://*)
      if [[ "$1" =~ $localhost_re ]]; then
        [ -n "${MUXY_PANE_ID:-}" ] && open_in_muxy "$1"
        exec /usr/bin/open -a "Google Chrome" "$1"
      fi
      exec /usr/bin/open -a "Google Chrome" "$1"
      ;;
  esac
fi
exec /usr/bin/open "$@"
